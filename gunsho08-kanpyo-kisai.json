  {
   "id": "gunsho08-kanpyo-kisai-0005",
   "pid": "1879502",
   "pages": [
    13
   ],
   "text": "亭子院歌合十左住吉のきしによる波夜さへや夢の通ひ路人めよくらむ右夕附夜おほろに人を見てしより天雲晴れぬ心地こそすれ左秋風に我身はなりぬ白雲のたえてきこえぬ人をこふとて右近けれと人め〓〓をもるころは雲井はるけき身とやなりなん左戀しきに侘てたましゐまとひなは空しきからの名にや殘らむ右あかすして今朝のかへりち思ほえす心を一つをきてこしかは左人しれすしたに流る〓涙川せきと〓めなむかけは見ゆると右貫之燃えもあはぬこなたかなたの思ひ哉淚の河の中にゆけはか〔以下關〕",
   "poems": [
    "183",
    "184",
    "185",
    "186",
    "187",
    "188",
    "189",
    "190"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "花のかを風のたよりにたくへてそ鶯さそふしるへにはやる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "谷かせにとくる氷のひまことにうちいつる波や春の初花",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "散と見てあるへきものを梅花うたて匂ひの袖にとまれる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "聲たえすなけや鶯一とせに二たひとたにくへき春かは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "梅のはなしるきかならてうつろは〓雪降やまぬ春とこそ見め",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春の日に霞わけつ〓とふ鴈の見えみみえすみ雲かくれ行",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "花の木も今はほりうへし春立ぼうつろふ色に人ならひけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春の野に若菜つまむとこし我を散かふ花に道はまとひぬ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "鶯はむへもなくらん花さくら咲とみしまにうつろひにけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "はる霞たなひく野邊のわか菜にもなり見てし哉人もつむやと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "淺みとり野邊の霞はつ〓めともこほれて匂ふ花櫻かな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "春た〓は花をみむてふ心こそ野邊の霞とともにたちぬれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "みよし野の山に咲たるさくら花雪かとのみそあやまたれける",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "年のうちはみな春なからはてな〓む花を見てたに心やるへく",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "春かすみあみにはりこめ花ちらはうつろひぬへし鶯とめよ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "春雨の色はこくしもみえなくに野邊のみとりをいかてそむ覽",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "はるなれと花もにほはぬ山里は物うかる音にうくひすそ鳴",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "咲花は千種なからにあたなれと誰かは春をうらみはてたる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "水のうへにあやをりみたる春雨や山のみとりをなへてそむ覽",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "色ふかくみる野邊たにも常ならは春は行ともかたみならまし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "駒なへてめも春の野にましりなむ若菜摘つる人は有やと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "鶯の谷よりいつる聲なくは春くることを誰かつけまし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "春なから年はくれなん散花をおしと鳴なる鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "大空をおほふはかりの袖もかな春咲花を風にまかせし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "霞立春の山邊にさくら花あかす散とやうくひすの鳴",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あまの原春はことにも見ゆる哉雲のたてるも色こかりけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "まきもくのひはらの霞たちかへりみれとも花の驚かれつ〓",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "白妙の浪路わけてや春はくる風吹からにはなも咲けり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "かすみたつ春の山邊は遠けれと吹來る風は花の香そする",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "散はなのまててふことをきかませは春降雪とふらせさらまし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "か〓る時あらしと思へは一とせなすへては春をなす〓とも哉",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "まててふにとまらぬ物と知なからしゐてそおしき春の別れを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "梅花香をはと〓めて色をのみ年ふる人の袖にそむらむ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "あかすして過行春の人ならはとくかへりこといはまし物を",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "梅か〓を袖に移してと〓めては春はすくともかたみならまし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "行春の跡たにありと見ましかは野へのまに〓〓とめまし物を",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "春霞色の干くさにみえつるはたなひく山の花のかけかも",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "夏の月ひかりおします照時はなかる〓水にかけらふそたつ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "くる〓かと見れは明ぬる夏の夜をあかすとや鳴山郭公",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "をしなへて五月の空を見渡せは草葉も水もみとり成けり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "菖蒲草いくらの五月あひくらむ來る年每にわかく見ゆらむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "なつの日のくるゝもしらす鳴蟬をとひもしてしか何とかうき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "郭公なきつる夏の山邊にはくつていたさぬ人やすむらむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "夏の日を天雲しはしかくさなむぬるほともなく明る夜にせん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "幾千たひ鳴かへるらむ足引の山ほとゝきす聲はわすれて",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "いつの間に花かれにけむ長くたにありせは夏の影とみましを",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "夜やくらき道やまとへる郭公我宿をしもすきかてにする",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "夏の夜のまつはもそよと吹風はいつれか雨の聲にかはれる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "夏虫にあらぬ我身のつれもなき人を思ひにもゆる比かな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "秋の野の草のたもとか花薄ほに出てまねく袖とみゆらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "秋といへは天雲まてにもえにしを空さへしるくなとか見ゆ覽",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "日くらしに秋の野山をわけくれは心にもあらぬ錦をそきる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "我ために來る秋にしもあらなくに虫の音聞は先そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "おく山に紅葉ふみわけ鳴鹿の聲きく時そ秋はかなしき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "秋の野の草はいとゝはみえなくにをく白露の玉とつらなる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "我のみや哀れと思はむきり〓〓す鳴夕かけのやまとなてしこ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "浦近くたつ秋霧はもしほやく煙とのみそ見え渡りける",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "秋風に初膓かねそ響なるたか玉章をかけて來つらむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "眺めつ〓人まつおりによふこ鳥いつかたへとか立歸りなく",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "夏草も夜の間は露にいこふらむ常にこかる〓我そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "琴の音にひ〓きかよへる松風はしらへても鳴蟬の聲かな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "はかもなき夏のくさ葉にをく露を命と賴む虫のはかなさ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "かりそめのみや賴まれぬ夏の日をなと空蟬のなきくらしつる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "夏の夜はふすかとすれは郭公鳴一こゑにあくる東雲",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "宵の間ははかなくみゆる夏虫にまとひまされる戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "夏の夜の月は程なく明なからあしたの間をそかこちよせける",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "空蟬の侘しきものを夏草の露にか〓れる身にこそ有けれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "匂ひつ〓散にし花そおもほゆる夏はみとりの葉のみ茂りて",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "蟬のこゑ聞はかなしな夏衣うすくや人のならむと思へは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "くる春にあはむことこそかたからめ過行方にをくれすも哉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "常盤なる松のみとりも春くれは今一しほの色まさりけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "日くるれは且ちる花をあたらしみ春の形見につみそいれつる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "恨つ〓と〓むる人のなけれはや山時鳥うかれて〓啼",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "吹風の我宿にくる夏の夜は月の影こそす〓しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "夏山にこひしき人や入にけむ聲ふりたて〓鳴郭公",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "夏の夜の露なと〓めそ蓮葉のま〓との玉と成しはてすは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "五月雨に物思ひをれは郭公夜ふかく鳴ていつち行覽",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "草しけみ下葉かれ行夏の日もわくとしわけは袖やひちなん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "夏草のしけき思ひは蚊遣火の下にのみこそもえ渡りけれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "夏の風我袂にしつ〓まれは思はむ人のつとにしてまし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "夏の夜の霜やをけるとみるまてに荒たる宿を照す月かけ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "去年の夏鳴ふるしてし郭公それかあらぬか聲のかはらぬ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "夏の夜は水やまされる天河なかる〓月の影もとゝめぬ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "ゆふされは螢よりけにもゆるとも光みにねは人そつれなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "山の井は水なきことそみえわたる秋の紅葉のちりてかくせは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "女郞花匂へる野邊に宿りせはあやなくあたの名をやたちなん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "秋風にさそはれ來つる鴈かねの雲ゐ遙にけふそ聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "白露に風のふきしく秋の野はつらぬきとめめ玉そちりける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "いつのまに秋穗たるらむ草と見し程幾日ともへたゝらなくに",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "鴈のねは風にきほひてわたれとも我待人のことつてそなき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "大空をとりかへすとも見えなくに星かとみゆる秋の草哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "秋風にほころひぬらむ藤袴つ〓りさせてふきり〓〓す鳴",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "秋の夜の雨ときこえて降つるは風に散つる紅葉なりけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "ちらねともかねてそおしき紅葉〓は今は限りの色とみつれは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "白波に秋の木のはの浮へるはあまのなかせる舟かとそ見る",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "秋のよのあまてる月の光にはをく白露を玉とこそ見れ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "秋の野にをける露をはひとりぬる我涙とも思ひしれかし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "膓金は風をさむみやはたをりめくたまく音のきり〓〓とする",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "植し時花まちとをにありし菊うつろふ秋にあはんとやみし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "白露の染いたす萩の下紅葉衣にうつす秋は來にけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "風寒み啼秋虫のなみたこそ草に色とる露とをくらめ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "花すゝきそよともすれは秋風の吹かとそきく衣なき身は",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "鴈かねにおとろく秋のよを寒み虫のをりたす衣をそきる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "秋風はたかたむけとか紅葉はを幣にきりつ〓吹ちらすらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "唐ころもほせと袂の露けきは我身の秋になれはなりけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "秋の露色のこと〓〓おけはこそ山も紅葉も干くさ成らめ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "あき風に聲をほにあけて行舟はあまの戶わたる鴈にさりける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "紅葉はの散こむ時は袖にうけむ土におちなはきすもこそつけ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "秋のせみさむき聲にそきこゆなる木のはの衣を風やぬきつる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "あきの夜の月の影こそ木の間より〔下句欠〕",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "秋の月草むらわかすてらせはややとせる露を玉とみすらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "なをさりに秋のみやまに入ぬれは錦のいろの衣をこそきれ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "秋山に戀する鹿の聲たて〓鳴そしぬへき君かこぬよは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "契りけむ心そつらき七夕の年にひとたひあふは逢かは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "年ことにあふとはすれと七夕のぬるよの數そ少なかけける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "かき曇りあられふりしけ白玉をしける庭とも人の見るかに",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "天河ふゆは空まてこほるらし石間に瀧つ音たにもせす",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "篠のはにをく霜よりも獨ぬる我衣手そさえまさりける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "流れ行水こほりぬる冬さへや猶うき草の跡は定めぬ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "雪ふりて年のくれゆく時にこそ終にもみちぬ松も見えけれ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "我宿は雪ふる野邊に道もなしいつこはかとか人のとめこむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "神無月しくれふるらしさほ山の正木のかつら色まさりゆく",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "冬くれは梅に雪こそ降か〓れいつれのえをか花とはおらむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "ほりてをきし池は鏡とこほれとも影にもみえぬ年そ經にける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "降雪のつもれる峯は白雲のたちもさはかすをるかとそみる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "みよしの〓山のしら雪ふみ分て入にし人のをとつれもせぬ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "吹風は色も見へねと冬くれは獨ぬるよの身にそしみける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "霜かれの枝となわひそ白雪を花にやとひてみれともあかす",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "嵐ふく山下里にふる雪はとくむめの花咲かとそ見る",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "雪のみそ枝にふりしき花もはもいにけむ方もみえすも有哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "白雪の八重ふりしける歸る山かへる〓〓も老にける哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "草も木も枯行冬の宿なれは雪ならすしてとふ人そなき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "ふる雪は枝にしはしもとまらなむ花も紅葉も絕てなきまは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "冬の池のうへは凍りてとちたるをいかてか月のそこにすむ覽",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "浦ちかくふり來る雪は白波の末の松山こすかとそ見る",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "なみた川みなくはかりの淵はあれと氷とけねは影も宿らぬ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "霜のうへに跡ふみつくる濵千鳥行ゑもなしと鳴のみそふる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "白雪のおりゐる宿とみえつるは降りくる雪の解けぬ成けり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "ちらねともかねてそおしき紅葉は〓今は限りの色と見つれは",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "冬さむみみのもにかくる增鏡とくも我なむ老まとふへく",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "冬の海に降いる雪やそこにゐて春たつ浪の花と咲くらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "月夜には花とそ見ゆる竹のうへに降しく雪を誰かはらはむ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "松の上にか〓れる雪は余所にして時まとはせる花とこそみれ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "雪のうちのみ山からこそおいはくれ頭の白く成をまつみよ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "ふゝみあへす消なむ雪を冬の日の花と見れはや鳥のとふらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "白露そ霜となりける冬のよはあまの河〔下欠〕",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "しら雪を分てわかる〓かたみには袖に淚の凍るなりけり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "わりなくも寐ても覺ても戀しきか心をいつちやらはわすれん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "鹿島なるつくまの神のつく〓〓と我身ひとつに戀をつみつる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "あかすして君を戀つる淚にそ浮きみしつみ〓やせわたりける",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "人をおもふ心のおきは身をそやく煙たつとは見えぬものから",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "明ぬとて歸る道にはこきたれて雨も泪もふりそほちつ〓",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "思ひにはあふ空さへやもえわたる朝たつ雲を煙とはして",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "我戀は深山かくれの草なれや茂さまされと知人のなき",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "契りけむ心そつらき織女の年に一たひ逢はあふかは",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "おもひ侘けふりは空に立ぬれとわりなくもなき戀のしるしか",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "つれもなき人をこふとて山彥のこたふるまても歎つる哉",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "紅の色にはいてしかくれぬの下に通ひて戀はしぬとも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "人を見て思ふ事たに有ものを空にこふるそはかなかりける",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "白玉の消えて涙と成ぬれは戀しきかけを袖にこそ見れ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "ほのに見し人に思ひをつけそめて心からこそしたに焦るれ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "ひとりぬる我手枕を畫はほし夜はぬらして幾代へぬらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "佗わたる我身のうらとなれ〓はや戀しき事のしき波に立つ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "つれなきを今は戀しと思へとも心よはくも落つるなみたか",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "年をへてもゆてふふしの山よりも逢はぬ思ひは我そ勝れる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "獨ぬる身の衣てはうみなれやみるに涙そまなくよせけれ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "限りなく深きおもひを忍ふれは身を殺すにもをとらさりけり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "思ひつ〓ひるはかくても慰めつ夜こそ涙つきすなかる〓",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "あかすして別れしよひの泪川よとみもなくもたきつ心か",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "しぬる命いきもやすると心みに玉のを計り逢はむといはなむ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "いとはれて今は限りとしりにしを更に昔の戀しかるらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "侘ひぬれはしゐて忘れんと思へとも夢てふ物そ人たのめなる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "戀侘てうちぬる中に行かよふ夢のた〓ちはうつ〓なるらむ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "冬見れは雪ふりつもる高きみね立白雲に見えまかふ哉",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "足引の山のかけはし冬くれは氷の上をよきそかねつる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "かきくらし散花とのみふる雪は冬のみやこの雲のちるかと",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "乙女子かひかけのうへに降雪は花のまかふにいつれたかへり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "ひかりまつ枝にか〓れる雪をこそ冬の花とはいふへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "一たひも戀しと思ふにくるしきは心そち〓に碎くへらなる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "河の瀨に靡くたま藻のみかくれて人にしられぬ戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "君こふる淚の床にみらぬれはみをつくしとそ我はなりぬる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "かけてれはち〓の黄金も數しりぬなと我戀のあふはかりなき",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "住吉のきしによる波夜さへや夢の通ひ路人めよくらむ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "夕附夜おほろに人を見てしより天雲晴れぬ心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "秋風に我身はなりぬ白雲のたえてきこえぬ人をこふとて",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "近けれと人め〓〓をもるころは雲井はるけき身とやなりなん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "戀しきに侘てたましゐまとひなは空しきからの名にや殘らむ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "あかすして今朝のかへりち思ほえす心を一つをきてこしかは",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "人しれすしたに流る〓涙川せきと〓めなむかけは見ゆると",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "燃えもあはぬこなたかなたの思ひ哉淚の河の中にゆけはか",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
